# 省钱方案：DeepSeek 规划与制作，Qwen 写稿与改写。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 两套方案都使用阿里云百炼配音。QWEN_API_KEY 留空时复用 DASHSCOPE_API_KEY。
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
TTS_MODEL=qwen-audio-3.0-tts-plus
TTS_VOICE=longanlingxin

# 质量优先方案：GPT 规划，Gemini 写稿，Claude 制作。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# 可选自定义服务
CUSTOM_API_KEY=
CUSTOM_BASE_URL=

# 留空使用仓库下的 .runtime 和 PATH 中的 Node。
# TEACHER_FLOW_RUNTIME=/absolute/path/to/teacher-flow
# TEACHER_RENDER_RUNTIME=/absolute/path/to/renderer
# TEACHER_DSH_RUNTIME=/absolute/path/to/deepseek-harness
# TEACHER_NODE_BIN=/absolute/path/to/node
# TEACHER_MODELS_FILE=/absolute/path/to/models.json
# TEACHER_FONT_PATH=/absolute/path/to/chinese-font.ttf
