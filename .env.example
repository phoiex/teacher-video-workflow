# 本地填写凭据，然后启动制作工具。空值不会发起模型请求。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
TTS_MODEL=qwen-audio-3.0-tts-plus

# 可选模型服务。角色配置在 models.json。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
CUSTOM_API_KEY=
CUSTOM_BASE_URL=

# 留空时使用仓库下的 .runtime 与 PATH 中的 Node。
# TEACHER_FLOW_RUNTIME=/absolute/path/to/teacher-flow
# TEACHER_RENDER_RUNTIME=/absolute/path/to/renderer
# TEACHER_NODE_BIN=/absolute/path/to/node
# TEACHER_MODELS_FILE=/absolute/path/to/models.json
# TEACHER_FONT_PATH=/absolute/path/to/chinese-font.ttf
